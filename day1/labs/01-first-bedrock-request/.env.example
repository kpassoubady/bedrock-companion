# Copy this file to .env and replace the dummy key before running the live request.
# Never commit or share the resulting .env file.
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=replace-with-your-short-term-bedrock-api-key
OPENAI_API_KEY=${AWS_BEARER_TOKEN_BEDROCK}
OPENAI_BASE_URL=https://bedrock-runtime.${AWS_REGION}.amazonaws.com/openai/v1
